# Copy to keystore.properties (gitignored) and fill in the blanks.
#
# Generate the keystore first:
#
#   keytool -genkeypair -v -keystore nighttorch-release.jks \
#     -alias nighttorch -keyalg RSA -keysize 4096 -validity 10000
#
# Back up both the .jks file and these passwords somewhere durable. If they are lost, the
# app can never be updated on Google Play under the same listing.
storeFile=nighttorch-release.jks
storePassword=
keyAlias=nighttorch
keyPassword=
