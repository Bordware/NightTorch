<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon. minSdk is 26, which is exactly where adaptive icons arrived, so this
  anydpi variant covers every supported device and no raster fallback is needed.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <!-- Themed icons (API 33+) need a flat silhouette, not the gradient artwork. -->
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
