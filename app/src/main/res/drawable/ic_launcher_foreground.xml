<!--
  NightTorch icon foreground: a crescent moon cradling a warm glow.

  Adaptive icon geometry: the canvas is 108x108dp but only the central 72x72dp is
  guaranteed visible once the launcher applies its mask, so the artwork is kept inside
  roughly 26..82 on both axes.

  The crescent is drawn as a single path using the even-odd trick — a full circle with a
  second, offset circle subtracted — rather than as two overlapping shapes, so it stays a
  clean silhouette when the launcher tints it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Outer halo: the light the crescent is throwing. -->
    <path
        android:pathData="M54,54m-31,0a31,31 0,1 1,62 0a31,31 0,1 1,-62 0"
        android:fillAlpha="0.16">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt" name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="31"
                android:startColor="#FFD08A"
                android:endColor="#00FFD08A" />
        </aapt:attr>
    </path>

    <!-- Inner halo, tighter and warmer. -->
    <path
        android:pathData="M54,54m-22,0a22,22 0,1 1,44 0a22,22 0,1 1,-44 0"
        android:fillAlpha="0.28">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt" name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="22"
                android:startColor="#FFC163"
                android:endColor="#00FFC163" />
        </aapt:attr>
    </path>

    <!--
      The crescent itself. Outer circle centred at (54,54) r=19, with a circle centred at
      (63,49) r=17 subtracted via evenOdd, leaving a waxing crescent opening to the
      upper-right — where the glow reads as coming from.
    -->
    <path
        android:fillType="evenOdd"
        android:pathData="M54,54m-19,0a19,19 0,1 1,38 0a19,19 0,1 1,-38 0zM63,49m-17,0a17,17 0,1 0,34 0a17,17 0,1 0,-34 0z">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt" name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="35"
                android:startY="73"
                android:endX="73"
                android:endY="35"
                android:startColor="#F2A93B"
                android:endColor="#FFE0A3" />
        </aapt:attr>
    </path>

    <!-- Spark: the light source the crescent is turned away from. -->
    <path
        android:pathData="M70,42m-4.5,0a4.5,4.5 0,1 1,9 0a4.5,4.5 0,1 1,-9 0"
        android:fillColor="#FFF1CE" />
</vector>
