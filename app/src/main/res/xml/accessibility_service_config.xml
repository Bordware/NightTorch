<?xml version="1.0" encoding="utf-8"?>
<!--
  Key filtering needs BOTH of the following. Either one alone silently delivers no key
  events at all, with no error anywhere to explain why (docs/architecture.md):

      android:accessibilityFlags="flagRequestFilterKeyEvents"
      android:canRequestFilterKeyEvents="true"

  accessibilityEventTypes is deliberately narrow rather than typeAllMask. This service reads
  no screen content and only needs key events; requesting every event type would be a
  privacy liability and a constant battery cost for no benefit (docs/architecture.md).
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagRequestFilterKeyEvents"
    android:canRequestFilterKeyEvents="true"
    android:description="@string/accessibility_service_description"
    android:notificationTimeout="100"
    android:summary="@string/accessibility_service_summary" />
